{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/core/1/core.feature_dependencies.result.schema.json",
  "title": "core.feature_dependencies result",
  "description": "In-session dependencies that negotiation enforces (CORE section 4.3). A profile trigger applies whenever the profile major is selected; a feature trigger applies only when that feature is selected. Dependencies on separate providers are not listed.",
  "type": "object",
  "required": [
    "dependencies"
  ],
  "properties": {
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "major",
          "trigger",
          "requires"
        ],
        "properties": {
          "profile": {
            "$ref": "../../core/1/common.schema.json#/$defs/profile_name"
          },
          "major": {
            "$ref": "../../core/1/common.schema.json#/$defs/profile_major"
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "profile"
                  }
                },
                "unevaluatedProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "feature"
                ],
                "properties": {
                  "kind": {
                    "const": "feature"
                  },
                  "feature": {
                    "$ref": "../../core/1/common.schema.json#/$defs/feature_name"
                  }
                },
                "unevaluatedProperties": false
              }
            ]
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "profile",
                "major",
                "features"
              ],
              "properties": {
                "profile": {
                  "$ref": "../../core/1/common.schema.json#/$defs/profile_name"
                },
                "major": {
                  "$ref": "../../core/1/common.schema.json#/$defs/profile_major"
                },
                "features": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "../../core/1/common.schema.json#/$defs/feature_name"
                  }
                }
              },
              "unevaluatedProperties": false
            }
          }
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
