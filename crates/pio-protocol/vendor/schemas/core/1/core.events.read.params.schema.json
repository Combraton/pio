{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/core/1/core.events.read.params.schema.json",
  "title": "core.events.read params",
  "allOf": [
    {
      "$ref": "../../core/1/query.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "core.events.read"
    },
    "payload": {
      "type": "object",
      "required": [
        "limit"
      ],
      "properties": {
        "cursor": {
          "$ref": "../../core/1/common.schema.json#/$defs/cursor"
        },
        "from": {
          "enum": [
            "start",
            "now"
          ]
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "../../core/1/common.schema.json#/$defs/subject_kind"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "oneOf": [
        {
          "required": [
            "cursor"
          ],
          "not": {
            "required": [
              "from"
            ]
          }
        },
        {
          "required": [
            "from"
          ],
          "not": {
            "required": [
              "cursor"
            ]
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
