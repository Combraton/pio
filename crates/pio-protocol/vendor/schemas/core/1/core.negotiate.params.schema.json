{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/core/1/core.negotiate.params.schema.json",
  "title": "core.negotiate params",
  "allOf": [
    {
      "$ref": "../../core/1/query.schema.json"
    }
  ],
  "properties": {
    "operation": {
      "const": "core.negotiate"
    },
    "payload": {
      "type": "object",
      "required": [
        "caller",
        "receive_limits",
        "profiles"
      ],
      "properties": {
        "caller": {
          "$ref": "../../core/1/common.schema.json#/$defs/party"
        },
        "receive_limits": {
          "type": "object",
          "required": [
            "max_frame_bytes"
          ],
          "properties": {
            "max_frame_bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 9007199254740991
            }
          },
          "unevaluatedProperties": false
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "name",
              "majors",
              "required",
              "required_features",
              "optional_features"
            ],
            "properties": {
              "name": {
                "$ref": "../../core/1/common.schema.json#/$defs/profile_name"
              },
              "majors": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "../../core/1/common.schema.json#/$defs/profile_major"
                }
              },
              "required": {
                "type": "boolean"
              },
              "required_features": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 64,
                "items": {
                  "$ref": "../../core/1/common.schema.json#/$defs/feature_name"
                }
              },
              "optional_features": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 64,
                "items": {
                  "$ref": "../../core/1/common.schema.json#/$defs/feature_name"
                }
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
