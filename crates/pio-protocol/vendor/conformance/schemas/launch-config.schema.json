                      "type": "string"
                    },
                    "dirty_snapshot": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "environment_digest": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "The basis the executor can observe for revalidation; conditions on anything else are unavailable."
          },
          "observe_host_basis": {
            "type": "object",
            "properties": {
              "repositories": {
                "type": "object",
                "additionalProperties": {
