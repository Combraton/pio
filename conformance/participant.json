{
  "format": "combraton-conformance-participant/1",
  "name": "pio-journal-fake-executor",
  "version": "0.1.0-dev",
  "description": "PIO journal-backed Core and Execution conformance service with the labeled executor.script fake host; no real adapters. Claims cover the five PLAN Execution features, public effects and bounded event output. The mutex/polling service loop is conformance-only, not the durable-host design. See the manifest for unsupported features and barriers.",
  "role": "provider",
  "binding": "unix",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      },
      {
        "name": "execution",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities",
      "core.effects",
      "execution.controller",
      "execution.discovery",
      "execution.output",
      "execution.workspaces",
      "execution.usage",
      "core.events.backpressure"
    ],
    "test_controls": [
      "clock.file",
      "store.faults",
      "executor.script"
    ],
    "test_barriers": [
      "session.closed",
      "backpressure.stall.started",
      "backpressure.limit.reached",
      "backpressure.connection.closed"
    ]
  },
  "launch": {
    "argv": [
      "{pio_binary}",
      "conformance",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--socket",
      "{socket_path}"
    ]
  },
  "mutants": {
    "argv": [],
    "names": []
  }
}
