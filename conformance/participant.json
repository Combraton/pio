{
  "format": "combraton-conformance-participant/1",
  "name": "pio-journal-fake-executor",
  "version": "0.1.0-dev",
  "description": "PIO journal-backed Core and Execution conformance service with an explicitly labeled executor.script fake host; no real adapter. Claims cover the five PLAN Execution features and public effect lifecycle. Event backpressure remains unclaimed. The polling service is not the durable-host design.",
  "role": "provider",
  "binding": "unix",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      },
      {
        "name": "execution",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities",
      "core.effects",
      "execution.controller",
      "execution.discovery",
      "execution.output",
      "execution.workspaces",
      "execution.usage"
    ],
    "test_controls": [
      "clock.file",
      "store.faults",
      "executor.script"
    ],
    "test_barriers": []
  },
  "launch": {
    "argv": [
      "{pio_binary}",
      "conformance",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--socket",
      "{socket_path}"
    ]
  },
  "mutants": {
    "argv": [],
    "names": []
  }
}
