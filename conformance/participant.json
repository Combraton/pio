{
  "format": "combraton-conformance-participant/1",
  "name": "pio-fake-host",
  "version": "0.1.0-dev",
  "description": "PIO conformance-only Core and core-test Unix service with fake-host tooling; no real adapters. Execution, public effects and event-backpressure are not claimed. m1-target.json is a future target, not evidence.",
  "role": "provider",
  "binding": "unix",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities"
    ],
    "test_controls": [
      "clock.file",
      "store.faults"
    ],
    "test_barriers": []
  },
  "launch": {
    "argv": [
      "{pio_binary}",
      "conformance",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--socket",
      "{socket_path}"
    ]
  },
  "mutants": {
    "argv": [],
    "names": []
  }
}
